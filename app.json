{
  "expo": {
    "name": "PDF Studio",
    "slug": "pdf-studio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.pdfstudio.local",
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "android": {
      "package": "app.pdfstudio.local",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-sharing",
      "expo-asset",
      ["expo-image-picker", {
        "cameraPermission": "PDF Studio gebruikt de camera om pagina's te scannen. De foto's blijven op je toestel.",
        "photosPermission": "PDF Studio gebruikt je foto's om ze in een PDF te zetten. Ze blijven op je toestel."
      }]
    ]
  }
}
